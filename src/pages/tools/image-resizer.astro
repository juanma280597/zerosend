---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import JsonLd from '../../components/JsonLd.astro';
---
<BaseLayout title="Resize Image Locally — Change Pixel Dimensions | ZeroSend" description="Resize JPG, PNG, and WebP image dimensions directly in your browser. Preserve aspect ratio and download without a file-processing upload.">
  <JsonLd data={{ '@context':'https://schema.org','@type':'WebApplication', name:'ZeroSend Image Resizer', applicationCategory:'UtilitiesApplication', isAccessibleForFree:true }} />
  <section class="tool-page"><div class="container narrow-wide"><p class="eyebrow">IMAGE TOOL</p><h1>Image Resizer</h1><p class="lead">Change width and height in pixels while keeping the work on your device.</p><PrivacyBadge />
    <div class="tool-shell" data-resizer><label class="dropzone"><strong>Choose an image</strong><span>JPG, PNG or WebP</span><input type="file" accept="image/jpeg,image/png,image/webp" /></label><div class="controls hidden" data-controls><div class="two-fields"><label>Width (px)<input data-width type="number" min="1" max="20000" /></label><label>Height (px)<input data-height type="number" min="1" max="20000" /></label></div><label class="check"><input data-lock type="checkbox" checked /> Keep aspect ratio</label><label>Quality for JPG/WebP <output data-quality-output>90%</output><input data-quality type="range" min="10" max="100" value="90" /></label><button class="button primary" data-process>Resize image</button></div><p class="status" data-status aria-live="polite"></p><div class="result hidden" data-result><img data-preview alt="Preview of resized image" /><div class="stats"><div><span>Original</span><strong data-original-dim></strong></div><div><span>Result</span><strong data-result-dim></strong></div><div><span>File size</span><strong data-result-size></strong></div></div><a class="button primary" data-download download>Download resized image</a></div></div>
    <article class="content-block"><h2>How to resize an image locally</h2><ol><li>Select your image.</li><li>Enter a new width or height.</li><li>Keep aspect ratio enabled to avoid stretching.</li><li>Resize and download the result.</li></ol><h2>When should you resize?</h2><p>Reducing pixel dimensions can dramatically reduce transfer size and memory use when an image is larger than its display target.</p><h2>FAQ</h2><h3>Does resizing crop the image?</h3><p>No. This tool scales the full image to the requested dimensions. Cropping will be a separate tool.</p><h3>Can enlarging improve detail?</h3><p>No. Increasing dimensions creates more pixels but cannot recover detail that is absent from the source.</p></article>
  </div></section>
</BaseLayout>
<script>
  import { loadImage, renderImage, canvasToBlob, formatBytes, fileExtensionForMime, safeBaseName } from '../../scripts/image-utils';
  const root=document.querySelector<HTMLElement>('[data-resizer]');
  if(root){const input=root.querySelector<HTMLInputElement>('input[type=file]')!,controls=root.querySelector<HTMLElement>('[data-controls]')!,w=root.querySelector<HTMLInputElement>('[data-width]')!,h=root.querySelector<HTMLInputElement>('[data-height]')!,lock=root.querySelector<HTMLInputElement>('[data-lock]')!,q=root.querySelector<HTMLInputElement>('[data-quality]')!,qo=root.querySelector<HTMLOutputElement>('[data-quality-output]')!,btn=root.querySelector<HTMLButtonElement>('[data-process]')!,status=root.querySelector<HTMLElement>('[data-status]')!,result=root.querySelector<HTMLElement>('[data-result]')!,preview=root.querySelector<HTMLImageElement>('[data-preview]')!,od=root.querySelector<HTMLElement>('[data-original-dim]')!,rd=root.querySelector<HTMLElement>('[data-result-dim]')!,rs=root.querySelector<HTMLElement>('[data-result-size]')!,download=root.querySelector<HTMLAnchorElement>('[data-download]')!;let ratio=1,ow=0,oh=0,url='';q.addEventListener('input',()=>qo.value=`${q.value}%`);input.addEventListener('change',async()=>{const file=input.files?.[0];controls.classList.toggle('hidden',!file);result.classList.add('hidden');if(!file)return;try{const img=await loadImage(file);ow=img.width;oh=img.height;ratio=ow/oh;w.value=String(ow);h.value=String(oh);img.dispose();status.textContent=`Original dimensions: ${ow} × ${oh}px.`}catch{status.textContent='Could not read this image.'}});w.addEventListener('input',()=>{if(lock.checked&&Number(w.value)>0)h.value=String(Math.max(1,Math.round(Number(w.value)/ratio)))});h.addEventListener('input',()=>{if(lock.checked&&Number(h.value)>0)w.value=String(Math.max(1,Math.round(Number(h.value)*ratio)))});btn.addEventListener('click',async()=>{const file=input.files?.[0],nw=Number(w.value),nh=Number(h.value);if(!file||!Number.isFinite(nw)||!Number.isFinite(nh)||nw<1||nh<1){status.textContent='Enter valid width and height values.';return}btn.disabled=true;status.textContent='Resizing locally…';try{const img=await loadImage(file),canvas=renderImage(img,nw,nh);img.dispose();const mime=['image/jpeg','image/png','image/webp'].includes(file.type)?file.type:'image/png',blob=await canvasToBlob(canvas,mime,Number(q.value)/100);if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(blob);preview.src=url;download.href=url;download.download=`${safeBaseName(file.name)}-${nw}x${nh}.${fileExtensionForMime(blob.type)}`;od.textContent=`${ow} × ${oh}`;rd.textContent=`${nw} × ${nh}`;rs.textContent=formatBytes(blob.size);result.classList.remove('hidden');status.textContent='Done. The resized file was created in your browser.'}catch(e){console.error(e);status.textContent='This image could not be resized.'}finally{btn.disabled=false}})}
</script>
