---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import JsonLd from '../../components/JsonLd.astro';
---
<BaseLayout title="Split PDF Locally — Extract Pages Without Upload | ZeroSend" description="Extract specific PDF pages or ranges into a new PDF directly in your browser. No source-file upload is required for processing.">
  <JsonLd data={{ '@context':'https://schema.org','@type':'WebApplication', name:'ZeroSend Split PDF', applicationCategory:'UtilitiesApplication', isAccessibleForFree:true }} />
  <section class="tool-page"><div class="container narrow-wide"><p class="eyebrow">PDF TOOL</p><h1>Split PDF</h1><p class="lead">Choose pages or ranges and create a new PDF locally.</p><PrivacyBadge />
    <div class="tool-shell" data-split><label class="dropzone"><strong>Choose one PDF</strong><span>We will read its page count in your browser</span><input type="file" accept="application/pdf,.pdf" /></label><div class="controls hidden" data-controls><p class="mini-note">Document: <strong data-name></strong> · <strong data-total></strong> pages</p><label>Pages to extract<input data-ranges type="text" inputmode="text" placeholder="1-3, 5, 8-10" aria-describedby="range-help" /></label><small id="range-help">Use page numbers and ranges separated by commas.</small><button class="button primary" data-process>Extract pages</button></div><p class="status" data-status aria-live="polite"></p><div class="result hidden" data-result><div class="stats"><div><span>Selected pages</span><strong data-count></strong></div><div><span>Result size</span><strong data-size></strong></div></div><a class="button primary" data-download download>Download extracted PDF</a></div></div>
    <article class="content-block"><h2>How to split or extract PDF pages locally</h2><ol><li>Select one PDF.</li><li>Enter pages such as <code>1-3, 5, 8-10</code>.</li><li>Extract the selected pages.</li><li>Download one new PDF containing them in the requested order.</li></ol><h2>Why this v0.1 creates one output</h2><p>For the first version, “split” means extracting one or more ranges into one new PDF. A later version can add separate output files per range and package them into a ZIP locally.</p><h2>Limitations</h2><p>Encrypted PDFs, corrupted documents, and files that exceed available browser memory may fail. Complex PDF features are not guaranteed to transfer perfectly.</p><h2>FAQ</h2><h3>Can I repeat a page?</h3><p>Yes. If you specify the same page more than once, it can appear more than once in the output.</p><h3>Do you upload the PDF to discover its page count?</h3><p>No. The PDF library reads the selected file in your browser.</p></article>
  </div></section>
</BaseLayout>
<script>
  import { PDFDocument } from 'pdf-lib';
  import { formatBytes, safeBaseName } from '../../scripts/image-utils';
  const parseRanges=(value:string,total:number)=>{const pages:number[]=[];for(const raw of value.split(',')){const part=raw.trim();if(!part)continue;if(/^\d+$/.test(part)){const n=Number(part);if(n<1||n>total)throw new Error(`Page ${n} is outside 1-${total}.`);pages.push(n-1);continue}const m=part.match(/^(\d+)\s*-\s*(\d+)$/);if(!m)throw new Error(`“${part}” is not a valid page or range.`);const a=Number(m[1]),b=Number(m[2]);if(a<1||b<1||a>total||b>total)throw new Error(`Range ${part} is outside 1-${total}.`);const step=a<=b?1:-1;for(let n=a;;n+=step){pages.push(n-1);if(n===b)break}}if(!pages.length)throw new Error('Enter at least one page.');return pages};
  const root=document.querySelector<HTMLElement>('[data-split]');
  if(root){const input=root.querySelector<HTMLInputElement>('input[type=file]')!,controls=root.querySelector<HTMLElement>('[data-controls]')!,name=root.querySelector<HTMLElement>('[data-name]')!,totalEl=root.querySelector<HTMLElement>('[data-total]')!,ranges=root.querySelector<HTMLInputElement>('[data-ranges]')!,btn=root.querySelector<HTMLButtonElement>('[data-process]')!,status=root.querySelector<HTMLElement>('[data-status]')!,result=root.querySelector<HTMLElement>('[data-result]')!,count=root.querySelector<HTMLElement>('[data-count]')!,size=root.querySelector<HTMLElement>('[data-size]')!,download=root.querySelector<HTMLAnchorElement>('[data-download]')!;let sourceBytes:ArrayBuffer|null=null,total=0,url='';input.addEventListener('change',async()=>{const file=input.files?.[0];controls.classList.add('hidden');result.classList.add('hidden');sourceBytes=null;if(!file)return;status.textContent='Reading PDF locally…';try{sourceBytes=await file.arrayBuffer();const pdf=await PDFDocument.load(sourceBytes.slice(0));total=pdf.getPageCount();name.textContent=file.name;totalEl.textContent=String(total);ranges.value=`1-${total}`;controls.classList.remove('hidden');status.textContent=`Ready. ${total} pages found.`}catch(e){console.error(e);status.textContent='This PDF could not be read. It may be encrypted or damaged.'}});btn.addEventListener('click',async()=>{const file=input.files?.[0];if(!file||!sourceBytes)return;btn.disabled=true;result.classList.add('hidden');try{const selected=parseRanges(ranges.value,total);status.textContent='Extracting pages locally…';const src=await PDFDocument.load(sourceBytes.slice(0)),out=await PDFDocument.create(),copied=await out.copyPages(src,selected);copied.forEach(p=>out.addPage(p));const bytes=await out.save(),blob=new Blob([bytes],{type:'application/pdf'});if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(blob);download.href=url;download.download=`${safeBaseName(file.name)}-pages.pdf`;count.textContent=String(selected.length);size.textContent=formatBytes(blob.size);result.classList.remove('hidden');status.textContent='Done. The extracted PDF was created in your browser.'}catch(e){status.textContent=e instanceof Error?e.message:'The selected pages could not be extracted.'}finally{btn.disabled=false}})}
</script>
