---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import JsonLd from '../../components/JsonLd.astro';
---
<BaseLayout title="Merge PDF Files Locally — No Upload Processing | ZeroSend" description="Combine multiple PDF files directly in your browser. Reorder them and download one merged PDF without uploading source files for processing.">
  <JsonLd data={{ '@context':'https://schema.org','@type':'WebApplication', name:'ZeroSend Merge PDF', applicationCategory:'UtilitiesApplication', isAccessibleForFree:true }} />
  <section class="tool-page"><div class="container narrow-wide"><p class="eyebrow">PDF TOOL</p><h1>Merge PDF</h1><p class="lead">Combine PDFs in the order you choose. The source files are read locally by your browser.</p><PrivacyBadge />
    <div class="tool-shell" data-merge><label class="dropzone"><strong>Choose PDF files</strong><span>Select two or more files</span><input type="file" accept="application/pdf,.pdf" multiple /></label><div class="file-list" data-list></div><button class="button primary hidden" data-process>Merge PDFs</button><p class="status" data-status aria-live="polite"></p><div class="result hidden" data-result><div class="stats"><div><span>Files</span><strong data-count></strong></div><div><span>Total pages</span><strong data-pages></strong></div><div><span>Result size</span><strong data-size></strong></div></div><a class="button primary" data-download download="zerosend-merged.pdf">Download merged PDF</a></div></div>
    <article class="content-block"><h2>How to merge PDFs without an upload</h2><ol><li>Select two or more PDF files.</li><li>Use the arrow controls to set their order.</li><li>Choose Merge PDFs.</li><li>Download the combined document created in your browser.</li></ol><h2>Useful for sensitive documents</h2><p>Local processing can be helpful when you need to combine invoices, forms, reports, or other PDFs and would prefer not to send the source documents to a conversion server.</p><h2>Limitations</h2><p>Very large PDFs can exceed the memory available to a phone or browser tab. Password-protected, encrypted, damaged, or unusual PDFs may not load correctly.</p><h2>FAQ</h2><h3>Does merging change page order inside each PDF?</h3><p>No. Pages keep their internal order; you control which whole PDF comes first.</p><h3>Are bookmarks and interactive features guaranteed?</h3><p>No. This MVP focuses on combining pages. Complex PDF features may not be preserved exactly.</p></article>
  </div></section>
</BaseLayout>
<script>
  import { PDFDocument } from 'pdf-lib';
  import { formatBytes } from '../../scripts/image-utils';
  const root=document.querySelector<HTMLElement>('[data-merge]');
  if(root){const input=root.querySelector<HTMLInputElement>('input[type=file]')!,list=root.querySelector<HTMLElement>('[data-list]')!,btn=root.querySelector<HTMLButtonElement>('[data-process]')!,status=root.querySelector<HTMLElement>('[data-status]')!,result=root.querySelector<HTMLElement>('[data-result]')!,count=root.querySelector<HTMLElement>('[data-count]')!,pages=root.querySelector<HTMLElement>('[data-pages]')!,size=root.querySelector<HTMLElement>('[data-size]')!,download=root.querySelector<HTMLAnchorElement>('[data-download]')!;let files:File[]=[];let url='';const draw=()=>{list.replaceChildren();files.forEach((file,i)=>{const row=document.createElement('div');row.className='file-row';const name=document.createElement('span');name.textContent=file.name;const actions=document.createElement('div');[['↑',-1],['↓',1]].forEach(([label,delta])=>{const b=document.createElement('button');b.type='button';b.textContent=String(label);b.className='icon-button';b.disabled=(i===0&&delta===-1)||(i===files.length-1&&delta===1);b.addEventListener('click',()=>{const j=i+Number(delta);[files[i],files[j]]=[files[j]!,files[i]!];draw()});actions.append(b)});const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.className='text-button';remove.addEventListener('click',()=>{files.splice(i,1);draw()});actions.append(remove);row.append(name,actions);list.append(row)});btn.classList.toggle('hidden',files.length<2);result.classList.add('hidden');status.textContent=files.length?`${files.length} PDF${files.length===1?'':'s'} selected.`:''};input.addEventListener('change',()=>{files=Array.from(input.files??[]);draw()});btn.addEventListener('click',async()=>{if(files.length<2)return;btn.disabled=true;status.textContent='Merging locally…';try{const out=await PDFDocument.create();let pageTotal=0;for(const file of files){const src=await PDFDocument.load(await file.arrayBuffer());const indices=src.getPageIndices();const copied=await out.copyPages(src,indices);copied.forEach(p=>out.addPage(p));pageTotal+=copied.length}const bytes=await out.save();const blob=new Blob([bytes],{type:'application/pdf'});if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(blob);download.href=url;count.textContent=String(files.length);pages.textContent=String(pageTotal);size.textContent=formatBytes(blob.size);result.classList.remove('hidden');status.textContent='Done. The merged PDF was created in your browser.'}catch(e){console.error(e);status.textContent='One or more PDFs could not be merged. Encrypted or damaged files may not be supported.'}finally{btn.disabled=false}})}
</script>
