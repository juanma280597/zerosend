---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import JsonLd from '../../components/JsonLd.astro';
---
<BaseLayout title="Convert JPG or PNG to WebP Locally | ZeroSend" description="Convert JPG and PNG images to WebP directly in your browser. Choose quality, preview the result, and download without uploading the selected image for processing.">
  <JsonLd data={{ '@context':'https://schema.org','@type':'WebApplication', name:'ZeroSend JPG PNG to WebP Converter', applicationCategory:'UtilitiesApplication', isAccessibleForFree:true }} />
  <section class="tool-page"><div class="container narrow-wide">
    <p class="eyebrow">IMAGE TOOL</p><h1>JPG / PNG to WebP</h1><p class="lead">Create a WebP copy locally for modern web delivery and smaller files in many cases.</p><PrivacyBadge />
    <div class="tool-shell" data-webp><label class="dropzone"><strong>Choose a JPG or PNG</strong><span>The image stays on your device for processing</span><input type="file" accept="image/jpeg,image/png" /></label><div class="controls hidden" data-controls><label>WebP quality <output data-quality-output>82%</output><input data-quality type="range" min="10" max="100" value="82" /></label><button class="button primary" data-process>Convert to WebP</button></div><p class="status" data-status aria-live="polite"></p><div class="result hidden" data-result><img data-preview alt="Preview of WebP result" /><div class="stats"><div><span>Original</span><strong data-original-size></strong></div><div><span>WebP</span><strong data-result-size></strong></div><div><span>Change</span><strong data-saving></strong></div></div><a class="button primary" data-download download>Download WebP</a></div></div>
    <article class="content-block"><h2>Convert an image to WebP in four steps</h2><ol><li>Select a JPG or PNG.</li><li>Choose a WebP quality level.</li><li>Convert locally in your browser.</li><li>Preview and download the result.</li></ol><h2>Why WebP?</h2><p>WebP supports lossy and lossless image compression and transparency. For many web graphics and photos it can provide smaller files than older formats, though the result depends on image content and quality settings.</p><h2>FAQ</h2><h3>Does PNG transparency survive?</h3><p>WebP supports transparency, and transparent pixels are preserved by the browser canvas where the source decodes correctly.</p><h3>Can the WebP be larger?</h3><p>Yes. Tiny, already-optimized, or unusual images can produce a larger result. Compare the sizes before replacing your original.</p></article>
  </div></section>
</BaseLayout>
<script>
  import { loadImage, renderImage, canvasToBlob, formatBytes, safeBaseName } from '../../scripts/image-utils';
  const root=document.querySelector<HTMLElement>('[data-webp]');
  if(root){const input=root.querySelector<HTMLInputElement>('input[type=file]')!,controls=root.querySelector<HTMLElement>('[data-controls]')!,quality=root.querySelector<HTMLInputElement>('[data-quality]')!,qo=root.querySelector<HTMLOutputElement>('[data-quality-output]')!,button=root.querySelector<HTMLButtonElement>('[data-process]')!,status=root.querySelector<HTMLElement>('[data-status]')!,result=root.querySelector<HTMLElement>('[data-result]')!,preview=root.querySelector<HTMLImageElement>('[data-preview]')!,os=root.querySelector<HTMLElement>('[data-original-size]')!,rs=root.querySelector<HTMLElement>('[data-result-size]')!,saving=root.querySelector<HTMLElement>('[data-saving]')!,download=root.querySelector<HTMLAnchorElement>('[data-download]')!;let url='';quality.addEventListener('input',()=>qo.value=`${quality.value}%`);input.addEventListener('change',()=>{controls.classList.toggle('hidden',!input.files?.length);result.classList.add('hidden');status.textContent=input.files?.[0]?`${input.files[0].name} ready.`:''});button.addEventListener('click',async()=>{const file=input.files?.[0];if(!file)return;button.disabled=true;status.textContent='Converting locally…';try{const img=await loadImage(file),canvas=renderImage(img,img.width,img.height);img.dispose();const blob=await canvasToBlob(canvas,'image/webp',Number(quality.value)/100);if(url)URL.revokeObjectURL(url);url=URL.createObjectURL(blob);preview.src=url;download.href=url;download.download=`${safeBaseName(file.name)}.webp`;os.textContent=formatBytes(file.size);rs.textContent=formatBytes(blob.size);const d=(file.size-blob.size)/file.size*100;saving.textContent=`${d>=0?'−':'+'}${Math.abs(d).toFixed(1)}%`;result.classList.remove('hidden');status.textContent='Done. Your WebP was created locally.'}catch(e){console.error(e);status.textContent='This image could not be converted in your browser.'}finally{button.disabled=false}})}
</script>
